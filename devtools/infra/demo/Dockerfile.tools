# syntax=docker/dockerfile:1.7
# One-shot tooling image for the demo stack: prisma migrate + reference seed + test users + public places.
# Kept separate from ../../Dockerfile so the Jenkins build targets are untouched.
# The base image digest and install steps intentionally mirror the `dependencies` stage of ../../Dockerfile.
FROM node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends openssl ca-certificates && apt-get clean
COPY package.json package-lock.json .npmrc ./
COPY prisma ./prisma
RUN npm ci --ignore-scripts && npx prisma generate
COPY . .
CMD ["sh", "-c", "npx prisma migrate deploy && npm run db:seed && npm run db:seed:test-users && npm run places:import-public"]
